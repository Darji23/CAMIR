# CAMIR Configuration

# -----------------------------------------------------------------------------
# Large Tier: Fireworks AI (Recommended Provider for Qwen2.5-72B-Instruct)
# -----------------------------------------------------------------------------
# Get your API key from https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Optional overrides (defaults to https://api.fireworks.ai/inference/v1):
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional model override (defaults to accounts/fireworks/models/qwen2p5-72b-instruct):
# HOSTED_MODEL_ID=accounts/fireworks/models/qwen2p5-72b-instruct

# -----------------------------------------------------------------------------
# Alternative Providers (OpenRouter, Together AI, or generic OpenAI-compatible)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_or_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
