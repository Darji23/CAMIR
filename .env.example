# CAMIR Configuration

# Hosted API Provider (OpenAI compatible endpoint, e.g. OpenRouter, Together AI, Fireworks)
OPENAI_API_KEY=your_api_key_here
# Optional base URL (e.g. https://api.together.xyz/v1 or https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Local Cache / Traces Directory (defaults to ./traces/camir_traces.sqlite)
# CAMIR_DB_PATH=./traces/camir_traces.sqlite
